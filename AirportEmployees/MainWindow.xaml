<Window x:Class="AirportEmployees.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirportEmployees"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0"
                  x:Name="EmployeesDataGrid"
                ItemsSource="{Binding Employees}"
                AutoGenerateColumns="False"
                  IsReadOnly="True"
                  >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding EmployeeId}" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Firstname}" />
                <DataGridTextColumn Header="Apellidos" Binding="{Binding Lastname}" />
                <DataGridTextColumn Header="Fecha nacimiento" Binding="{Binding Birthdate}" />
                <DataGridTextColumn Header="Sexo" Binding="{Binding Sex}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <Button Click="BackPage">Anterior</Button>
            <TextBlock Text="{Binding Page}" />
            <Button Click="NextPage" Margin="10 0 0 0">Siguiente</Button>
        </StackPanel>
    </Grid>
</Window>
